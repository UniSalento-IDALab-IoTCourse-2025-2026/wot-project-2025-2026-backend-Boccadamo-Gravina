KEYCLOAK_VERSION=26.7.1

# URL pubblico di Keycloak (quello che usa il browser). Finisce nel claim "iss".
KC_HOSTNAME=http://localhost:8080

# Database di Keycloak (PostgreSQL)
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me

# Admin iniziale di Keycloak usato solo al primo avvio con db vuoto
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
